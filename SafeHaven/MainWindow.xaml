<Window x:Class="SafeHavenWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SafeHaven AI"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinHeight="600"
        MinWidth="960"
        Background="#111827">

    <DockPanel>
        <!-- ÜST NAVBAR -->
        <Border DockPanel.Dock="Top"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SafeHaven AI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Erzurum Büyükşehir Belediyesi • Afet Koordinasyon Merkezi"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                        <TextBlock Text="Sistem Aktif" Foreground="#22C55E" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                    <TextBlock x:Name="LastSyncText"
                               Text="Son Senkronizasyon: --:--"
                               Foreground="#9CA3AF"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ALT FOOTER -->
        <Border DockPanel.Dock="Bottom"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <TextBlock Text="AFAD • Kandilli • OpenStreetMap • Belediye Risk Analiz Sistemi"
                       Foreground="#6B7280"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </Border>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ACİL DURUM BANNER -->
        <Border x:Name="EmergencyBanner"
                Grid.Row="0"
                Background="#7F1D1D"
                CornerRadius="14"
                Padding="8,6"
                Margin="0,0,0,8"
                Visibility="Collapsed">

            <DockPanel>
                <TextBlock Text="🚨 ACİL DURUM MODU AKTİF"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left"/>

                <TextBlock x:Name="EmergencyDescriptionText"
                           FontSize="12"
                           Foreground="#FCA5A5"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- OBJEKTİF KARAR BANNER -->
        <Border Grid.Row="1"
                Background="#1E3A5F"
                CornerRadius="12"
                Padding="8,6"
                Margin="0,0,0,8"
                BorderBrush="#3B82F6"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="⚖ Objektif Afet Karar Sistemi — Kararlar objektif risk skoru ve yapısal verilerle verilir."
                           FontWeight="SemiBold"
                           Foreground="#DBEAFE"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="2"
                    Background="#111827"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Stretch">

            <!-- 1. SEKME: ANA SAYFA -->
            <TabItem Header="🏠 Ana Sayfa | Son Depremler">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MaxHeight="110"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Türkiye Son Depremler"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">

                        <Border Background="#1F2937" CornerRadius="14" Padding="16" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Listelenen Deprem" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock x:Name="TotalEarthquakeText" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F2937" CornerRadius="14" Padding="16" Margin="4">
                            <StackPanel>
                                <TextBlock Text="En Büyük Deprem" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock x:Name="MaxMagnitudeText" Text="0.0" Foreground="#EF4444" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F2937" CornerRadius="14" Padding="16" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Ortalama Derinlik" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock x:Name="AverageDepthText" Text="0 km" Foreground="#FACC15" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F2937" CornerRadius="14" Padding="16" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Son Güncelleme" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock x:Name="LastUpdateText" Text="-" Foreground="#10B981" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <Border Grid.Row="2"
                            Background="#1F2937"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,6">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="AFAD / Kandilli Benzeri Canlı Deprem Akışı"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="EarthquakesGrid"
                                      Grid.Row="1"
                                      Style="{StaticResource SafeHavenDataGrid}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih / Saat" Binding="{Binding Tarih}" Width="170"/>
                                    <DataGridTextColumn Header="Yer" Binding="{Binding Yer}" Width="*"/>
                                    <DataGridTextColumn Header="Büyüklük" Binding="{Binding Buyukluk}" Width="100"/>
                                    <DataGridTextColumn Header="Derinlik" Binding="{Binding Derinlik}" Width="100"/>
                                    <DataGridTextColumn Header="Enlem" Binding="{Binding Enlem}" Width="100"/>
                                    <DataGridTextColumn Header="Boylam" Binding="{Binding Boylam}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#1F2937"
                            CornerRadius="12"
                            Padding="10">

                        <StackPanel>
                            <TextBlock Text="🤖 AI Deprem Özeti"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="EarthquakeAiSummaryText"
                                       Text="Son deprem verileri yüklendiğinde AI özeti burada görüntülenecektir."
                                       Foreground="#D1D5DB"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. SEKME: BİNA RİSK HARİTASI -->
            <TabItem Header="🏢 Bina Risk Haritası">
                <Grid Margin="0,4,0,0" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.15*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOL PANEL -->
                    <Border Grid.Column="0"
                            Background="#1F2937"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,10,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*" MinHeight="160"/>
                                <RowDefinition Height="*" MinHeight="72" MaxHeight="200"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="🗺️ Deprem Risk Haritası"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,6"/>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Toplam Bina" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="TotalBuildingText" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Acil Müdahale" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="EmergencyBuildingText" Text="0" Foreground="#EF4444" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Yüksek Risk" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="HighRiskBuildingText" Text="0" Foreground="#F97316" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Ort. Risk" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="AverageRiskText" Text="0" Foreground="#FACC15" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Bina riski:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,8,0"/>
                                <TextBlock Text="● Düşük" Foreground="#22C55E" FontSize="10" Margin="0,0,6,0"/>
                                <TextBlock Text="● Orta" Foreground="#FACC15" FontSize="10" Margin="0,0,6,0"/>
                                <TextBlock Text="● Yüksek" Foreground="#F97316" FontSize="10" Margin="0,0,6,0"/>
                                <TextBlock Text="● Acil" Foreground="#EF4444" FontSize="10"/>
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Background="#111827"
                                    CornerRadius="8">
                                <wv2:WebView2 x:Name="MapView"/>
                            </Border>

                            <DataGrid x:Name="BuildingsGrid"
                                      Grid.Row="4"
                                      MaxHeight="200"
                                      Style="{StaticResource SafeHavenDataGrid}"
                                      RowHeight="32"
                                      FontSize="13"
                                      Margin="0,6,0,0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsReadOnly="True"
                                      MouseDoubleClick="BuildingsGrid_MouseDoubleClick">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Mahalle" Binding="{Binding Mahalle}" Width="120"/>
                                    <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="*"/>
                                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskSkoru}" Width="55"/>
                                    <DataGridTextColumn Header="Seviye" Binding="{Binding RiskSeviyesi}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- SAĞ PANEL -->
                    <Border Grid.Column="1"
                            Background="#1F2937"
                            CornerRadius="12"
                            Padding="12">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🤖 AI Bina Analizi"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Seçilen Bina / Adres" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="SelectedBuildingText"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           LineHeight="24"
                                           Margin="0,4,0,12"/>

                                <TextBlock Text="Risk Skoru" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="RiskScoreText"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#EF4444"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Önerilen Aksiyon" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="ActionText"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Risk Özeti (AI)" Foreground="#9CA3AF" FontSize="11"/>

                                <Border Background="#111827"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0">
                                    <TextBlock x:Name="AiExplanationText"
                                               Foreground="White"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="AI Güven Skoru"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <ProgressBar x:Name="AiConfidenceBar"
                                             Height="18"
                                             Maximum="100"
                                             Value="0"
                                             Margin="0,8,0,0"/>

                                <TextBlock x:Name="AiConfidenceText"
                                           Foreground="#10B981"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>

                                <TextBlock Text="Karar Faktörleri"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <Border Background="#111827"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0">
                                    <TextBlock x:Name="DecisionFactorsText"
                                               Foreground="White"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="⚠ Bu Binada Kritik Nüfus"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <Border Background="#111827"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0"
                                        BorderBrush="#7F1D1D"
                                        BorderThickness="1">
                                    <TextBlock x:Name="CriticalPopulationText"
                                               Foreground="#FCA5A5"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Tahliye Zorluğu"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <TextBlock x:Name="EvacuationDifficultyText"
                                           Foreground="#FACC15"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="🤖 Yapısal Analiz"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,12,0,0"/>

                                <Border Background="#1F2937"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0"
                                        BorderBrush="#374151"
                                        BorderThickness="1">
                                    <TextBlock x:Name="StructuralAiText"
                                               Foreground="#FDE68A"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Text="Bina seçildiğinde AI yapısal analiz burada görüntülenecektir."/>
                                </Border>

                                <Button x:Name="RefreshButton"
                                        Content="🔄 Verileri Yenile"
                                        Height="48"
                                        Margin="0,20,0,0"
                                        Click="RefreshButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. SEKME: GÜVENLİ ALANLAR -->
            <TabItem Header="🛡️ Güvenli Alanlar">
                <Grid Margin="0,4,0,0" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.15*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOL PANEL -->
                    <Border Grid.Column="0"
                            Background="#1F2937"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,10,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*" MinHeight="160"/>
                                <RowDefinition Height="*" MinHeight="72" MaxHeight="200"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="🛡️ Deprem Anı Güvenli Alanlar"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,6"/>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Toplam Alan" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="TotalSafeZoneText" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Toplam Kapasite" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="TotalCapacityText" Text="0" Foreground="#10B981" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Ort. Güvenlik" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="AverageSafeScoreText" Text="0" Foreground="#FACC15" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#111827" CornerRadius="8" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Ort. Doluluk" Foreground="#9CA3AF" FontSize="10"/>
                                        <TextBlock x:Name="AverageOccupancyText" Text="%0" Foreground="#F97316" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <Border Grid.Row="2"
                                    Background="#111827"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    MaxHeight="72"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="📊 Doluluk Özeti"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,0,0,4"/>
                                    <StackPanel x:Name="OccupancyOverviewPanel"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Doluluk:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,8,0"/>
                                <TextBlock Text="●Uygun ●Yoğun ●Kritik" Foreground="#9CA3AF" FontSize="10"/>
                            </StackPanel>

                            <Border Grid.Row="4"
                                    Background="#111827"
                                    CornerRadius="8">
                                <wv2:WebView2 x:Name="SafeZoneMapView"/>
                            </Border>

                            <DataGrid x:Name="SafeZonesGrid"
                                      Grid.Row="5"
                                      MaxHeight="200"
                                      Style="{StaticResource SafeHavenDataGrid}"
                                      RowHeight="32"
                                      FontSize="13"
                                      Margin="0,6,0,0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsReadOnly="True"
                                      MouseDoubleClick="SafeZonesGrid_MouseDoubleClick">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Alan Adı" Binding="{Binding Ad}" Width="*"/>
                                    <DataGridTextColumn Header="Mahalle" Binding="{Binding Mahalle}" Width="110"/>
                                    <DataGridTextColumn Header="Kapasite" Binding="{Binding Kapasite}" Width="100"/>
                                    <DataGridTextColumn Header="Doluluk %" Binding="{Binding DolulukGosterim}" Width="100"/>
                                    <DataGridTextColumn Header="Ulaşım" Binding="{Binding UlasimDurumu}" Width="120"/>
                                    <DataGridTextColumn Header="Güvenlik Skoru" Binding="{Binding GuvenlikSkoru}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- SAĞ PANEL -->
                    <Border Grid.Column="1"
                            Background="#1F2937"
                            CornerRadius="16"
                            Padding="20">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🤖 AI Güvenli Alan Analizi"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Seçilen Alan / Konum" Foreground="#9CA3AF" FontSize="11"/>
                                <TextBlock x:Name="SelectedSafeZoneText"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           LineHeight="24"
                                           Margin="0,4,0,12"/>

                                <TextBlock Text="Güvenlik Skoru" Foreground="#9CA3AF" FontSize="14"/>
                                <TextBlock x:Name="SafeZoneScoreText"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="#10B981"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Alan Profili (AI)" Foreground="#9CA3AF" FontSize="14"/>

                                <Border Background="#111827"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0">
                                    <TextBlock x:Name="SafeZoneAiExplanationText"
                                               Foreground="White"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="AI Güven Skoru"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <ProgressBar x:Name="SafeZoneConfidenceBar"
                                             Height="18"
                                             Maximum="100"
                                             Value="0"
                                             Margin="0,8,0,0"/>

                                <TextBlock x:Name="SafeZoneConfidenceText"
                                           Foreground="#10B981"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>

                                <TextBlock Text="Karar Faktörleri"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <Border Background="#111827"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,6,0,0">
                                    <TextBlock x:Name="SafeZoneFactorsText"
                                               Foreground="White"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Alan Doluluk Oranı"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           Margin="0,16,0,0"/>

                                <TextBlock x:Name="SafeZoneOccupancyLabel"
                                           Text="Doluluk"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>

                                <TextBlock x:Name="SafeZoneOccupancyPercentText"
                                           Text="%0"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="#22C55E"
                                           Margin="0,4,0,8"/>

                                <ProgressBar x:Name="SafeZoneOccupancyBar"
                                             Height="22"
                                             Maximum="100"
                                             Value="0"
                                             Margin="0,0,0,8"/>

                                <TextBlock x:Name="SafeZoneOccupancyLevelText"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
